            "type": "string",
            "nullable": true
          },
          "publicId": {
            "type": "string",
            "nullable": true
          },
          "isPrimary": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "PropertyDTO": {
        "type": "object",
        "properties": {
          "sellRent": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "propertyTypeId": {
            "type": "integer",
            "format": "int32"
          },
          "furnishingTypeId": {
            "type": "integer",
            "format": "int32"
          },
          "price": {
            "type": "integer",
            "format": "int32"
          },
          "bhk": {
            "type": "integer",
            "format": "int32"
          },
          "builtArea": {
            "type": "integer",
            "format": "int32"
          },
          "cityId": {
            "type": "integer",
            "format": "int32"
          },
          "readyToMove": {
            "type": "boolean"
          },
          "carpetArea": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "address": {
            "type": "string",
            "nullable": true
          },
          "address2": {
            "type": "string",
            "nullable": true
          },
          "floorNo": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
