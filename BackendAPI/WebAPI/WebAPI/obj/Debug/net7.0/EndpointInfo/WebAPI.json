            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "gated": {
            "type": "boolean",
            "nullable": true
          },
          "maintenance": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "estPossessionOn": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "age": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "view": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
