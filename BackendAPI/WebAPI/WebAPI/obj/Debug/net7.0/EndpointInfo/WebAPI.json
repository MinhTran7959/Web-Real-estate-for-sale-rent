            "nullable": true
          },
          "phonenumber": {
            "type": "string",
            "nullable": true
          },
          "otherContactInformation": {
            "maxLength": 300,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PhotoDTO": {
        "type": "object",
